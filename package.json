{
  "name": "shadows-of-the-city",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run content:compile && npm run build --workspaces --if-present",
    "content:compile": "npm run compile --workspace @sotc/content-compiler",
    "content:migrate": "npm run migrate --workspace @sotc/content-compiler",
    "content:migration:verify": "npm run migrate:verify --workspace @sotc/content-compiler",
    "content:report": "npm run report --workspace @sotc/content-compiler",
    "content:validate": "npm run validate --workspace @sotc/content-compiler",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "verify": "npm run lint && npm run typecheck && npm run content:validate && npm run content:migration:verify && npm run test && npm run build && npm run format:check"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@types/node": "^24.1.0",
    "eslint": "^9.32.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.38.0",
    "vitest": "^3.2.4"
  }
}
